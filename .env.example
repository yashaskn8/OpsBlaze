# Copy to .env and replace both values for your local machine.
OPSBLAZE_DATABASE_URL=postgresql+asyncpg://opsblaze:replace-me@localhost:5432/opsblaze
OPSBLAZE_LOCAL_TOKEN=replace-with-a-long-random-local-token
OPSBLAZE_ENVIRONMENT=development
OPSBLAZE_TEMPORAL_ADDRESS=127.0.0.1:7233
OPSBLAZE_TEMPORAL_NAMESPACE=default
OPSBLAZE_TEMPORAL_TASK_QUEUE=opsblaze-incidents-v1
