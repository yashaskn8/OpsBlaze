# Copy to .env and fill in. Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opsblaze

# Temporal local dev server (Docker-free); state persisted to this file
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_DB_FILE=.local/temporal.db

# Stage 11 & Stage 11.1: Server-side Authentication & Policy Signing
# In production, set OPSBLAZE_ENV=production and provide distinct 32+ byte random secrets
OPSBLAZE_ENV=development
AUTH_SECRET_KEY=replace-with-secure-random-32-byte-hex-in-production
POLICY_SIGNING_SECRET=replace-with-secure-random-32-byte-hex-in-production
POLICY_SIGNING_KEY_ID=opsblaze-signer-v1
