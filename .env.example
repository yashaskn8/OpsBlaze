# Copy to .env and replace both values for your local machine.
OPSBLAZE_DATABASE_URL=postgresql+asyncpg://opsblaze:replace-me@localhost:5432/opsblaze
# Dedicated projector URL must use different PostgreSQL LOGIN credentials.
# Never copy this secret into source control or share the application owner's.
# OPSBLAZE_PROJECTOR_DATABASE_URL=postgresql+asyncpg://opsblaze_projector:replace-me@localhost:5432/opsblaze
OPSBLAZE_LOCAL_TOKEN=replace-with-a-long-random-local-token
OPSBLAZE_REVIEW_TOKEN=use-a-different-long-random-reviewer-token
OPSBLAZE_REVIEW_EPOCH=1
OPSBLAZE_ENVIRONMENT=development
OPSBLAZE_TEMPORAL_ADDRESS=127.0.0.1:7233
OPSBLAZE_TEMPORAL_NAMESPACE=default
OPSBLAZE_TEMPORAL_TASK_QUEUE=opsblaze-incidents-v1
# Production multi-host readiness requires two distinct fresh worker host
# identities for *each* of dispatcher and incident_worker. Set this only
# on the corresponding authorized host, with a stable non-sensitive ID.
# OPSBLAZE_WORKER_HOST_ID=worker-a
OPSBLAZE_MIN_DISTINCT_WORKER_HOSTS=2
# Production requires TLS; never commit real API keys.
OPSBLAZE_TEMPORAL_TLS_ENABLED=false
# OPSBLAZE_TEMPORAL_API_KEY=
OPSBLAZE_ADMISSION_LIMIT_PER_MINUTE=30
OPSBLAZE_STUCK_AFTER_SECONDS=300

# Optional redacted OpenTelemetry OTLP/HTTP collector.
# Disabled unless explicitly configured. HTTPS required in production.
# OPSBLAZE_OTEL_TRACES_ENDPOINT=https://your-trusted-collector/v1/traces
OPSBLAZE_OTEL_SAMPLE_RATIO=0.1

# Optional development-only AI read-only advisory.
# Keep OPENAI_API_KEY in your untracked local environment, never commit it.
OPSBLAZE_AI_ADVISORY_ENABLED=false
OPSBLAZE_AI_ADVISORY_MODEL=gpt-6.2-sol

# Production-only OAuth2/OIDC JWT verification: all three must be set.
# Use a dedicated access-token audience and same-host HTTPS JWKS URL.
OPSBLAZE_OIDC_ISSUER=
OPSBLAZE_OIDC_AUDIENCE=
OPSBLAZE_OIDC_JWKS_URL=
# Once an authorized production provider is configured, the read-only
# preflight below verifies HTTPS discovery and bounded RSA signing metadata:
# OPSBLAZE_ENVIRONMENT=production python -m backend.security.provider_preflight
# It does NOT verify browser authorization, tokens or IdP revocation delivery.

# Optional signed IdP security-event integration (production only).
# Distinct from the API token audience; events are signed RS256 JWTs.
# OPSBLAZE_IDP_EVENT_AUDIENCE=opsblaze-security-events
