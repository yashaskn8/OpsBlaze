[Unit]
Description=OpsBlaze Community native Temporal simulator store
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=opsblaze-temporal
Group=opsblaze-temporal
StateDirectory=opsblaze-temporal
StateDirectoryMode=0700
WorkingDirectory=/var/lib/opsblaze-temporal
ExecStart=/usr/local/bin/temporal server start-dev --ip 127.0.0.1 --port 7233 --headless --db-filename /var/lib/opsblaze-temporal/temporal.db
Restart=always
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
